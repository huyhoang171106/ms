diff -ruN '--exclude=__pycache__' '--exclude=.pytest_cache' '--exclude=.git' a/tests/test_repro_empty_table.py b/tests/test_repro_empty_table.py
--- a/tests/test_repro_empty_table.py	1970-01-01 08:00:00.000000000 +0800
+++ b/tests/test_repro_empty_table.py	2026-11-15 00:25:23.488212836 +0700
@@ -0,0 +1,9 @@
+from tinydb_demo.pretty import render_table
+
+
+def test_empty_table_renders_empty_string():
+    assert render_table([]) == ''
+
+
+def test_non_empty_table_still_renders_headers():
+    assert render_table([{'a': 1, 'b': 2}]) == 'a  b'
diff -ruN '--exclude=__pycache__' '--exclude=.pytest_cache' '--exclude=.git' a/tinydb_demo/pretty.py b/tinydb_demo/pretty.py
--- a/tinydb_demo/pretty.py	2026-10-29 15:19:32.690682172 +0700
+++ b/tinydb_demo/pretty.py	2026-11-15 00:25:27.713289446 +0700
@@ -1,4 +1,6 @@
 def render_table(rows):
+    if not rows:
+        return ''
     headers = list(rows[0])
     widths = [len(header) for header in headers]
     return '  '.join(_pad_header(header, width) for header, width in zip(headers, widths))
