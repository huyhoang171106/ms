diff -ruN '--exclude=__pycache__' '--exclude=.pytest_cache' '--exclude=.git' a/tests/test_format.py b/tests/test_format.py
--- a/tests/test_format.py	1970-01-01 08:00:00.000000000 +0800
+++ b/tests/test_format.py	2026-11-15 00:21:51.779080959 +0700
@@ -0,0 +1,14 @@
+from tinydb_demo.format import format_tags
+
+
+def test_format_tags_joins_sorted_tags():
+    assert format_tags({'title': 'hello', 'tags': ['b', 'a']}) == 'a, b'
+
+
+def test_format_tags_handles_note_without_tags():
+    assert format_tags({'title': 'hello', 'body': 'x'}) == ''
+
+
+def test_format_tags_handles_empty_or_missing_tags_value():
+    assert format_tags({'title': 'hello', 'tags': []}) == ''
+    assert format_tags({'title': 'hello', 'tags': None}) == ''
diff -ruN '--exclude=__pycache__' '--exclude=.pytest_cache' '--exclude=.git' a/tinydb_demo/format.py b/tinydb_demo/format.py
--- a/tinydb_demo/format.py	2026-10-29 15:19:32.690682172 +0700
+++ b/tinydb_demo/format.py	2026-11-15 00:21:51.777080917 +0700
@@ -1,2 +1,2 @@
 def format_tags(note):
-    return ', '.join(sorted(note['tags']))
+    return ', '.join(sorted(note.get('tags') or ()))
