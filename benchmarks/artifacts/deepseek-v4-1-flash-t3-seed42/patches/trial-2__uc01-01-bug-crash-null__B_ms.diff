diff -ruN '--exclude=__pycache__' '--exclude=.pytest_cache' '--exclude=.git' a/tests/test_format.py b/tests/test_format.py
--- a/tests/test_format.py	1970-01-01 08:00:00.000000000 +0800
+++ b/tests/test_format.py	2026-11-14 22:09:03.595485021 +0700
@@ -0,0 +1,9 @@
+from tinydb_demo.format import format_tags
+
+
+def test_format_tags_joins_sorted_tags():
+    assert format_tags({'title': 'hello', 'tags': ['b', 'a']}) == 'a, b'
+
+
+def test_format_tags_handles_missing_tags():
+    assert format_tags({'title': 'hello', 'body': 'x'}) == ''
