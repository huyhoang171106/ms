+from tinydb_demo.pretty import render_table
+
+
+def test_render_table_empty_rows_is_empty_string():
+    assert render_table([]) == ''
+
+
+def test_render_table_renders_headers_of_first_row():
+    assert render_table([{'alpha': 1, 'beta': 2}, {'alpha': 3, 'beta': 4}]) == 'alpha  beta'
